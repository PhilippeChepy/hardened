Let mimalloc 3 live inside the C library (MI_LIBC_BUILD): a TLS model,
MI_TLS_MODEL_LIBC, keeps the theaps and the thread-local array in the C
library thread structure (lvalue macros MI_LIBC_TLS_<name> it defines), and
thread exit is the C library's to report (no pthread key, no thread locals).

diff -ru pa/mimalloc/include/mimalloc/prim/prim-tls.h pb/mimalloc/include/mimalloc/prim/prim-tls.h
--- a/mimalloc/include/mimalloc/prim/prim-tls.h
+++ b/mimalloc/include/mimalloc/prim/prim-tls.h
@@ -50,7 +50,7 @@
 
 
 // Default TLS model
-#if !defined(MI_TLS_MODEL_LOCAL) && !defined(MI_TLS_MODEL_PTHREADS) && !defined(MI_TLS_MODEL_FIXED) && !defined(MI_TLS_MODEL_WIN32)
+#if !defined(MI_TLS_MODEL_LOCAL) && !defined(MI_TLS_MODEL_PTHREADS) && !defined(MI_TLS_MODEL_FIXED) && !defined(MI_TLS_MODEL_WIN32) && !defined(MI_TLS_MODEL_LIBC)
 #if defined(_WIN32)
 #define MI_TLS_MODEL_WIN32        1
 #elif defined(__APPLE__) || defined(__OpenBSD__) || defined(__ANDROID__)  // and FreeBSD?
@@ -275,6 +275,20 @@
   return __mi_theap_cached;
 }
 
+#elif MI_TLS_MODEL_LIBC
+// Built into the C library (MI_LIBC_BUILD), which has no thread locals of its own: its thread
+// structure holds the theaps, as the lvalues `MI_LIBC_TLS_theap_default` and
+// `MI_LIBC_TLS_theap_cached` it defines. The cached theap starts as NULL.
+#define MI_THEAP_INITASNULL  1
+
+static inline mi_theap_t* _mi_theap_default(void) {
+  return (mi_theap_t*)MI_LIBC_TLS_theap_default;
+}
+
+static inline mi_theap_t* _mi_theap_cached(void) {
+  return (mi_theap_t*)MI_LIBC_TLS_theap_cached;
+}
+
 #elif MI_TLS_MODEL_PTHREADS
 // Dynamic pthread slots. This can be fast depending on the platform (default for macOS and OpenBSD)
 // On some platforms (like macOS), the loader might allocate on thread local declarations which
