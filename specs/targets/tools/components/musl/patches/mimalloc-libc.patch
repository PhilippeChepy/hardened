diff -ru pa/mimalloc/src/prim/unix/prim.c pb/mimalloc/src/prim/unix/prim.c
--- a/mimalloc/src/prim/unix/prim.c
+++ b/mimalloc/src/prim/unix/prim.c
@@ -1060,9 +1060,10 @@
 // Thread init/done
 //----------------------------------------------------------------
 
-#if defined(MI_USE_PTHREADS)
+#if defined(MI_USE_PTHREADS) && !MI_TLS_MODEL_LIBC
 
 // use pthread local storage keys to detect thread ending
+// (in the C library, its thread exit calls `_mi_thread_done`)
 // (and used with MI_TLS_PTHREADS for the default theap)
 // atomic as a thread may initialize while the process is exiting and deleting the key
 static _Atomic(pthread_key_t) _mi_heap_default_key = MI_ATOMIC_VAR_INIT(MI_PTHREAD_KEY_INVALID);
diff -ru pa/mimalloc/src/util/threadlocal.c pb/mimalloc/src/util/threadlocal.c
--- a/mimalloc/src/util/threadlocal.c
+++ b/mimalloc/src/util/threadlocal.c
@@ -43,7 +43,15 @@
   - mi_slot_fast: a single dedicated thread local for slightly faster access. (used for the main heap's theap)
 ----------------------------------------------------------- */
 
-#if MI_TLS_MODEL_PTHREADS || defined(__APPLE__)   // macOS has fast pthreads
+#if MI_TLS_MODEL_LIBC
+// In the C library's thread structure, as the lvalues `MI_LIBC_TLS_<name>` it defines.
+#define mi_define_thread_local(tp,name,initval) \
+  static inline tp   name##_peek(void)    { return (tp)MI_LIBC_TLS_##name; } \
+  static inline tp   name##_get(void)     { tp result = name##_peek(); return (result!=NULL ? result : initval); } \
+  static inline bool name##_set(tp val)   { MI_LIBC_TLS_##name = val; return true; } \
+  static inline void name##_delete(void)  {  }
+
+#elif MI_TLS_MODEL_PTHREADS || defined(__APPLE__)   // macOS has fast pthreads
 // Use pthreads
 #define mi_define_thread_local(tp,name,initval) \
   static pthread_key_t __##name##_key = MI_PTHREAD_KEY_INVALID; \
