+/*
+ * numeric_id() - Parses a user or group ID written in decimal digits, for
+ * systems without a user database entry for the daemon.
+ */
+static int numeric_id(const char *str, unsigned int *id)
+{
+    char *end;
+    unsigned long value;
+
+    if (str[0] < '0' || str[0] > '9') {
+        return 0;
+    }
+    errno = 0;
+    value = strtoul(str, &end, 10);
+    if (errno != 0 || *end != '\0' || value > 0xfffffffeUL) {
+        return 0;
+    }
+    *id = (unsigned int)value;
+    return 1;
+}
