# hardened kernel configuration, merged over x86_64_defconfig.
#
# Everything needed to boot on the supported platforms is built in; modules (signed with an
# ephemeral build key, signatures enforced) are for optional hardware and features.
# The build fails if any line below does not end up in the final .config.

# --- Boot: UKI, no initramfs, dm-verity root set up by dm-init -------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=n
CONFIG_BLK_DEV_INITRD=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEVTMPFS_SAFE=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_ISO9660_FS=n
CONFIG_VFAT_FS=m
CONFIG_SQUASHFS=n

# --- Virtual hardware ------------------------------------------------------------------------
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_ACPI_BUTTON=y

# --- TPM / measured boot ---------------------------------------------------------------------
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_SECURITYFS=y

# --- Containers ------------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_WIREGUARD=m

# --- Modules: signed (required by lockdown), and loadable only from the dm-verity root -------
# Signed with the persistent key of build/keys (deterministic RSA signatures: reproducible), and
# pinned to the verity root by LoadPin, so a leaked key alone loads nothing.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# Not the default certs/signing_key.pem, which the kernel's Makefile regenerates at every build.
CONFIG_MODULE_SIG_KEY="certs/hardened-modules.pem"
CONFIG_MODPROBE_PATH=""

# --- Hardening -------------------------------------------------------------------------------
# EXPERT exposes the options removing legacy syscalls below.
CONFIG_EXPERT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOADPIN=y
CONFIG_SECURITY_LOADPIN_ENFORCE=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,bpf"
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_PROC_KCORE=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_LEGACY_TIOCSTI=n
CONFIG_LDISC_AUTOLOAD=n
CONFIG_USELIB=n
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_X32_ABI=n
CONFIG_MODIFY_LDT_SYSCALL=n
CONFIG_IO_URING=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_DEBUG_FS=n

# Page-cache write primitives disabled outright, as in sks-templates
# ("Copy Fail" CVE-2026-31431, "Dirty Frag" CVE-2026-43284 / CVE-2026-43500).
CONFIG_CRYPTO_USER_API_AEAD=n
CONFIG_INET_ESP=n
CONFIG_INET6_ESP=n
CONFIG_INET_IPCOMP=n
CONFIG_INET6_IPCOMP=n
CONFIG_AF_RXRPC=n

# --- Unneeded on cloud VMs -------------------------------------------------------------------
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_BT=n
CONFIG_NFS_FS=n
CONFIG_AGP=n
CONFIG_LOGO=n
