# The hardened SDK: the toolchain every component is compiled with.
#
# Nothing from this image ships in the OS: it only provides compilers and image tooling.
# Inputs are pinned: the base image by digest, Debian packages through a snapshot.debian.org date,
# Go and rustup by checksum, the Rust toolchain by version.

FROM docker.io/library/debian:trixie@sha256:15a71cc87173e191d5046f9c4288db4e8954b67f92e48d9587087826b0afe562

ARG DEBIAN_SNAPSHOT=20261020T000000Z
ARG GO_VERSION=1.27.3
ARG GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
ARG RUSTUP_VERSION=1.29.2
ARG RUSTUP_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
ARG RUST_VERSION=1.99.1

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} trixie main" > /etc/apt/sources.list \
 && echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} trixie-security main" >> /etc/apt/sources.list \
 && apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      # compilers and build systems
      build-essential bison flex gawk bc pkg-config autoconf automake libtool \
      meson ninja-build gperf python3 python3-jinja2 python3-pyelftools python3-pefile \
      # kernel
      libelf-dev libssl-dev cpio kmod dwarves \
      # gcc (for libgcc_s)
      libgmp-dev libmpfr-dev libmpc-dev zlib1g-dev \
      # systemd-stub configure dependencies
      libmount-dev libcap-dev \
      # image tooling
      erofs-utils e2fsprogs cryptsetup-bin qemu-utils sbsigntool openssl \
      # running images
      qemu-system-x86 ovmf swtpm swtpm-tools \
      # misc
      ca-certificates curl git file xz-utils zstd \
 && rm -rf /var/lib/apt/lists/*

RUN curl -sSfL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
 && echo "${GO_SHA256}  /tmp/go.tgz" | sha256sum -c - \
 && tar -C /usr/local -xzf /tmp/go.tgz \
 && rm /tmp/go.tgz

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    GOTOOLCHAIN=local \
    GOFLAGS=-trimpath \
    PATH=/usr/local/cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN curl -sSfL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
 && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" \
 && rm /tmp/rustup-init \
 && chmod -R a+rwX /usr/local/rustup /usr/local/cargo

WORKDIR /work
